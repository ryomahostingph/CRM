# PHP-FPM Dockerfile for ChurchCRM (nginx deployments)

############################################
# 1. COMPOSER BUILD STAGE
############################################
FROM composer:2 AS php-build

WORKDIR /app

# copy full source
COPY . .

# install PHP dependencies
RUN composer install --no-dev --optimize-autoloader --no-interaction


############################################
# 2. NODE BUILD STAGE (frontend assets)
############################################
FROM node:24 AS node-build

WORKDIR /app

COPY . .

RUN npm install
RUN npm run build


############################################
# 3. BASE PHP-FPM IMAGE
############################################
FROM php:8.4-fpm AS base

LABEL maintainer="ChurchCRM"

EXPOSE 9000

# system dependencies
RUN apt-get update && \
    apt-get install -y \
        libcurl4-openssl-dev \
        libfreetype6-dev \
        libicu-dev \
        libjpeg-dev \
        libonig-dev \
        libpng-dev \
        libxml2-dev \
        libzip-dev \
        gettext \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j$(nproc) \
        bcmath \
        curl \
        exif \
        gd \
        gettext \
        iconv \
        intl \
        mbstring \
        mysqli \
        opcache \
        pdo_mysql \
        xml \
        zip

# PHP config
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    sed -i 's/^upload_max_filesize.*/upload_max_filesize = 2M/' $PHP_INI_DIR/php.ini && \
    sed -i 's/^post_max_size.*/post_max_size = 2G/' $PHP_INI_DIR/php.ini && \
    sed -i 's/^memory_limit.*/memory_limit = 256M/' $PHP_INI_DIR/php.ini && \
    sed -i 's/^max_execution_time.*/max_execution_time = 120/' $PHP_INI_DIR/php.ini


############################################
# 4. PRODUCTION IMAGE (CLEAN)
############################################
FROM base AS prod

WORKDIR /var/www/html

# copy backend (already composer-built)
COPY --from=php-build /app /var/www/html

# copy frontend build output
COPY --from=node-build /app /var/www/html

# fix permissions (important for nginx/php-fpm)
RUN chown -R www-data:www-data /var/www/html